# Dev container for CloudLM: Ubuntu + vLLM (engine) + Go (agent dev tooling).
# vLLM serves Prometheus metrics at GET /metrics on $HOST:$PORT (see specs.md).
#
# Build:  docker build -f Dockerfile.dev -t cloudlm-dev .
# Run:    docker run --rm -it --gpus all --network host \
#           -v "$PWD":/app -v /path/to/models:/models \
#           -e LLM_PATH=/models/<model> cloudlm-dev
#
# NOTE: the pip `vllm` wheel is CUDA-only. CPU / Intel iGPU / NPU need a
# different vLLM build (CPU or XPU/OpenVINO backend), i.e. a different install step.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip \
        build-essential git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Go toolchain, copied from the official image (matches go.mod)
COPY --from=golang:1.27 /usr/local/go /usr/local/go
ENV GOPATH=/go
ENV PATH=/usr/local/go/bin:/go/bin:/opt/venv/bin:$PATH
RUN go install github.com/air-verse/air@latest

# vLLM in an isolated venv
RUN python3 -m venv /opt/venv && pip install vllm

WORKDIR /app

# Runtime contract (specs.md); override with -e at `docker run`
ENV ENGINE=vLLM \
    HOST=127.0.0.1 \
    PORT=3000 \
    LLM_PATH=""

ENV AGENT_HOST=0.0.0.0 \
    AGENT_PORT=8080

# 3000: engine (vLLM /metrics). 8080: agent's GET /metrics/HOST:PORT.
# Not needed with --network host; otherwise publish with -p 3000:3000 -p 8080:8080.
EXPOSE 3000 8080

# Serve the model; metrics come for free at /metrics.
CMD ["sh", "-c", "exec vllm serve \"$LLM_PATH\" --host \"$HOST\" --port \"$PORT\""]
